<!DOCTYPE html>
<html>
  <head>
    <style>
      body {
        font-family: sans-serif;
        color: #333;
        line-height: 1.6;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
      }
      .btn {
        display: inline-block;
        padding: 12px 24px;
        background-color: #000;
        color: #fff;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        margin: 20px 0;
      }
      .muted {
        color: #71717a;
        font-size: 14px;
      }
      .warning {
        border-top: 1px solid #e4e4e7;
        margin-top: 30px;
        padding-top: 20px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Reset your password</h2>

      <p>Hi {{ firstName }},</p>
      <p>
        We received a request to reset the password for your account. If you made this request, click the button below to choose a new secure password:
      </p>

      <a href="{{ resetLink }}" class="btn">Reset Password</a>

      <p class="muted">For your security, this link will expire in 30 minutes.</p>

      <div class="warning">
        <p class="muted">
          <strong>Didn't request this?</strong>
          <br />
          
        If you didn't ask to reset your password, you can safely ignore this email. Your password will not be changed and your account remains perfectly secure.

        </p>
      </div>
    </div>
  </body>
</html>

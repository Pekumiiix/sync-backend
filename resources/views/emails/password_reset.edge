<!DOCTYPE html>
<html
  lang="en"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Reset Your Password</title>
    <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
    <!--Progressive enhancement only: clients that support @import/linked fonts
    (Apple Mail, iOS/Android Mail, Gmail app, newer webmail) render DM Sans /
    Instrument Sans. Everything else silently falls back to the Helvetica,
    Arial, sans-serif stack set inline on every text element below — nothing
    breaks or looks unstyled where the font isn't supported (e.g. Outlook
    Windows, older Gmail webmail).-->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Instrument+Sans:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style="margin:0; padding:0; width:100%; background-color:#ffffff;">
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="width:100%; border-collapse:collapse; margin:0; padding:0; background-color:#ffffff;"
    >
      <tr>
        <td align="center" style="padding:0;">
          <!--[if mso]>
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td>
        <![endif]-->
          <table
            role="presentation"
            width="480"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width:100%; max-width:480px; border-collapse:collapse;"
          >
            <tr>
              <td style="padding:28px 16px;">
                <!--Logo-->
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="border-collapse:collapse;"
                >
                  <tr>
                    <td style="padding-bottom:46px; vertical-align:middle;">
                      <img
                        src="https://i.ibb.co/WWdnk3LP/logo.png"
                        alt="SYNC logo"
                        width="22"
                        height="22"
                        style="width:22px; height:22px; vertical-align:middle; border:0; display:inline-block; outline:none; text-decoration:none;"
                      />
                      <span
                        style="font-family:'Instrument Sans', 'Segoe UI', Helvetica, Arial, sans-serif; font-size:18px; font-weight:600; color:#24273F; vertical-align:middle; padding-left:4px;"
                      >
                        SYNC
                      </span>
                    </td>
                  </tr>
                </table>
                <!--Card border-radius has no CSS support in Outlook (Windows/desktop)
                and will degrade gracefully to square corners there; the background
                fill and border still render correctly, so no VML fallback is needed
                for this container.-->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="width:100%; border-collapse:separate;"
                >
                  <tr>
                    <td
                      style="padding:24px 16px; background-color:#F8FAFC; border:1px solid #CBD5E1; border-radius:16px;"
                    >
                      <!--Inner content table-->
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="width:100%; border-collapse:collapse;"
                      >
                        <tr>
                          <td style="padding-bottom:8px;">
                            <p
                              style="margin:0; font-family:'DM Sans', Helvetica, Arial, sans-serif; font-size:20px; font-weight:500; line-height:28px; color:#0F172A;"
                            >
                              Reset your password
                            </p>
                          </td>
                        </tr>
                        <tr>
                          <td style="padding-bottom:18px;">
                            <p
                              style="margin:0; font-family:'DM Sans', Helvetica, Arial, sans-serif; font-size:14px; line-height:20px; color:#666879;"
                            >
                              Hi
                              {{ firstName }}, we got a request to reset the password for your Sync account. Click below to choose a new one and get back to your bookmarks.
                            </p>
                          </td>
                        </tr>
                        <!--Bulletproof button-->
                        <tr>
                          <td style="padding-bottom:18px;">
                            <!--[if mso]>
                          <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="__EDGE_EXPR_1__" style="height:38px;v-text-anchor:middle;width:160px;" arcsize="50%" stroke="f" fillcolor="#6B4CF5">
                          <w:anchorlock/>
                          <center style="color:#F0EDFE;font-family:Arial,sans-serif;font-size:12px;font-weight:500;">Reset password</center>
                          </v:roundrect>
                          <![endif]-->
                            <!--[if !mso]><!-->
                            <a
                              href="{{ resetUrl }}"
                              style="display:inline-block; height:14px; line-height:14px; padding:12px 16px; background-color:#6B4CF5; color:#F0EDFE; font-family:'DM Sans', Helvetica, Arial, sans-serif; font-size:12px; font-weight:500; text-decoration:none; border-radius:999px;"
                            >
                              Reset password
                            </a>
                            <!--<![endif]-->
                          </td>
                        </tr>

                        <tr>
                          <td style="padding-bottom:18px;">
                            <table
                              role="presentation"
                              width="100%"
                              cellpadding="0"
                              cellspacing="0"
                              border="0"
                              style="border-collapse:collapse;"
                            >
                              <tr>
                                <td
                                  height="1"
                                  style="height:1px; line-height:1px; font-size:0; background-color:#E2E8F0;"
                                >
                                  &nbsp;
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>

                        <tr>
                          <td style="padding-bottom:18px;">
                            <p
                              style="margin:0; font-family:'DM Sans', Helvetica, Arial, sans-serif; font-size:12px; line-height:18px; color:#666879;"
                            >
                              This link expires in 60 minutes. If you didn't request a password reset, no action is needed, your password stays the same.
                            </p>
                          </td>
                        </tr>

                        <tr>
                          <td>
                            <p
                              style="margin:0; font-family:'DM Sans', Helvetica, Arial, sans-serif; font-size:12px; color:#64748B;"
                            >
                              Button not working? Paste this link into your browser:
                            </p>
                            <p style="margin:0; padding-top:2px;">
                              <a
                                href="{{ resetUrl }}"
                                style="font-family:'DM Sans', Helvetica, Arial, sans-serif; font-size:12px; color:#6B4CF5; text-decoration:none; word-break:break-all;"
                              >
                                {{ resetUrl }}
                              </a>
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
                <!--Footer-->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="width:100%; border-collapse:collapse;"
                >
                  <tr>
                    <td style="padding-top:46px; text-align:center;">
                      <p
                        style="margin:0; padding-bottom:10px; font-family:'DM Sans', Helvetica, Arial, sans-serif; font-size:12px; line-height:100%; color:#666879; text-align:center;"
                      >
                        Sync keeps your bookmarks in one place across every browser.
                      </p>
                      <p
                        style="margin:0; font-family:'DM Sans', Helvetica, Arial, sans-serif; font-size:12px; line-height:100%; color:#666879; text-align:center;"
                      >
                        ©
                        {{ new Date().getFullYear() }}
                        Sync, Inc.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <!--[if mso]>
        </td></tr></table>
        <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>

<!DOCTYPE html>
<html
  lang="en"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Verify Your Email</title>
    <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  </head>
  <body style="margin:0; padding:0; width:100%; background-color:#ffffff;">
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="width:100%; border-collapse:collapse; margin:0; padding:0; background-color:#ffffff;"
    >
      <tr>
        <td align="center" style="padding:0;">
          <!--[if mso]>
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td>
        <![endif]-->
          <table
            role="presentation"
            width="480"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width:100%; max-width:480px; border-collapse:collapse;"
          >
            <tr>
              <td style="padding:28px 16px;">
                <!--Logo-->
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="border-collapse:collapse;"
                >
                  <tr>
                    <td style="padding-bottom:46px; vertical-align:middle;">
                      <img
                        src="https://i.ibb.co/WWdnk3LP/logo.png"
                        alt="SYNC logo"
                        width="22"
                        height="22"
                        style="width:22px; height:22px; vertical-align:middle; border:0; display:inline-block; outline:none; text-decoration:none;"
                      />
                      <span
                        style="font-family:'Segoe UI', Helvetica, Arial, sans-serif; font-size:18px; font-weight:600; color:#24273F; vertical-align:middle; padding-left:4px;"
                      >
                        SYNC
                      </span>
                    </td>
                  </tr>
                </table>
                <!--Body-->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="width:100%; border-collapse:collapse;"
                >
                  <tr>
                    <td style="padding-bottom:8px;">
                      <p
                        style="margin:0; font-family:'Segoe UI', Helvetica, Arial, sans-serif; font-size:20px; font-weight:500; line-height:28px; color:#0F172A;"
                      >
                        Verify Your Email
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom:18px;">
                      <p
                        style="margin:0; font-family:Helvetica, Arial, sans-serif; font-size:12px; line-height:20px; color:#666879;"
                      >
                        Hi
                        {{ firstName }}, welcome to Sync! Confirm this is your email address and we'll start pulling your bookmarks together from every browser you use.
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom:18px;">
                      <p
                        style="margin:0; font-family:Helvetica, Arial, sans-serif; font-size:12px; line-height:22px; color:#64748B;"
                      >
                        Enter this code in the app:
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom:18px;">
                      <!--[if mso]>
                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" style="width:140px;height:44px;v-text-anchor:middle;" arcsize="22%" stroke="f" fillcolor="#F1F5F9">
                    <center style="color:#0F172A;font-family:Arial,sans-serif;font-size:22px;font-weight:500;">__EDGE_EXPR_1__</center>
                    </v:roundrect>
                    <![endif]-->
                      <!--[if !mso]><!-->
                      <table
                        role="presentation"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-collapse:collapse;"
                      >
                        <tr>
                          <td
                            style="background-color:#F1F5F9; border-radius:10px; padding:8px 12px;"
                          >
                            <p
                              style="margin:0; font-family:Helvetica, Arial, sans-serif; font-size:22px; font-weight:500; line-height:33px; color:#0F172A; letter-spacing:1px;"
                            >
                              {{ code }}
                            </p>
                          </td>
                        </tr>
                      </table>
                      <!--<![endif]-->
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom:18px;">
                      <p
                        style="margin:0; font-family:Helvetica, Arial, sans-serif; font-size:12px; color:#64748B;"
                      >
                                                                      
                        Or paste this link into your browser:

                        <br />
                        <a
                          href="{{ verifyUrl }}"
                          style="font-family:Helvetica, Arial, sans-serif; font-size:12px; line-height:100%; color:#6B4CF5; text-decoration:none; word-break:break-all;"
                        >
                          {{ verifyUrl }}
                        </a>
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom:18px;">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border-collapse:collapse;"
                      >
                        <tr>
                          <td
                            height="1"
                            style="height:1px; line-height:1px; font-size:0; background-color:#E2E8F0;"
                          >
                            &nbsp;
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom:18px;">
                      <p
                        style="margin:0; font-family:Helvetica, Arial, sans-serif; font-size:12px; line-height:20px; color:#64748B;"
                      >
                        This link and code expire in 12 hours. If you didn't create a Sync account, you can safely ignore this email.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <!--Footer-->
            <tr>
              <td style="padding-top:46px; text-align:center;">
                <p
                  style="margin:0; padding-bottom:10px; font-family:Helvetica, Arial, sans-serif; font-size:12px; line-height:100%; color:#666879; text-align:center;"
                >
                  Sync keeps your bookmarks in one place across every browser.
                </p>
                <p
                  style="margin:0; font-family:Helvetica, Arial, sans-serif; font-size:12px; line-height:100%; color:#666879; text-align:center;"
                >
                  ©
                  {{ new Date().getFullYear() }}
                  Sync, Inc.
                </p>
              </td>
            </tr>
          </table>
          <!--[if mso]>
        </td></tr></table>
        <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>

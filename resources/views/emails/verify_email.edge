<!DOCTYPE html>
<html>
  <head>
    <style>
      body {
        font-family: sans-serif;
        color: #333;
        line-height: 1.6;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
      }
      .btn {
        display: inline-block;
        padding: 12px 24px;
        background-color: #000;
        color: #fff;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        margin: 20px 0;
      }
      .code-box {
        background: #f4f4f5;
        padding: 15px;
        text-align: center;
        font-size: 32px;
        letter-spacing: 5px;
        font-weight: bold;
        border-radius: 6px;
        margin: 20px 0;
      }
      .muted {
        color: #71717a;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Verify your email address</h2>

      <p>Hi {{ firstName }},</p>
      <p>
        Welcome aboard! To complete your registration and secure your account, please verify your email address.
      </p>

      <a href="{{ verificationLink }}" class="btn">Verify Email Address</a>

      <p>Or enter this 6-digit code in your browser:</p>

      <div class="code-box">{{ code }}</div>

      <p class="muted">For your security, this link and code will expire in 12 hours.</p>
      <br />
      <p class="muted">If you didn't request this, you can safely ignore this email.</p>
    </div>
  </body>
</html>
